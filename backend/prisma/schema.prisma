// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- 1. UTENTI E RUOLI (Chi usa l'app) ---

enum UserRole {
  OWNER   // Proprietario del locale
  STAFF   // Cameriere, Bagnino, Barbiere
  CLIENT  // Cliente finale che ordina
}

model Tenant {
  id        String   @id @default(uuid())
  name      String   // Es: "Pizzeria Da Mario"
  type      String   @default("RESTAURANT") // RESTAURANT, BEACH, BARBER
  createdAt DateTime @default(now())

  // Relazioni
  users      User[]
  areas      Area[]
  resources    Resource[]
  categories Category[]
  products   Product[]
  orders     Order[]
  bookings   Booking[]
  mapElements MapElement[]
  employees   Employee[]
  shifts        Shift[]
  leaves        LeaveRequest[]  
  customers      Customer[]
  checklistTemplates ChecklistTemplate[]
  checklistInstances ChecklistInstance[]
  // Diciamo al Ristorante che ha una lista di Fornitori associata a lui.
  // Le parentesi quadre [] indicano "Uno a Molti" (Un ristorante, tanti fornitori).
  suppliers      Supplier[]
  // Diciamo al Ristorante che possiede un suo inventario/magazzino privato.
  inventoryItems InventoryItem[]
  // Diciamo al Ristorante che ha uno storico di ordini effettuati.
  purchaseOrders PurchaseOrder[]
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  password String
  name     String?
  role     UserRole @default(CLIENT)

  // Se è STAFF o OWNER, appartiene a un Tenant. Se è CLIENT, questo può essere null (o legato all'ultimo locale visitato)
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  employee    Employee? 
  customerProfile Customer? // Collegamento 1-a-1 con la rubrica del ristoratore

  bookings Booking[]
  orders   Order[]
}

// --- 2. RISORSE FISICHE (Dove ci si siede) ---

model Area {
  id       String @id @default(uuid())
  name     String // Es: "Sala Interna", "Dehor", "Fila 1"
  
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  resources Resource[]

  //Per disegnare il box dell'area sulla mappa
  positionX Float    @default(0.0)
  positionY Float    @default(0.0)
  width     Float    @default(400.0) 
  height    Float    @default(300.0)
}

model Resource {
  id        String  @id @default(uuid())
  name      String  // Es: "Tavolo 4", "Ombrellone 12"
  capacity  Int     @default(2)
  status    String  @default("FREE") // FREE, BUSY, RESERVED
  
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  areaId    String
  area      Area   @relation(fields: [areaId], references: [id])

  bookings  Booking[]
  orders    Order[]

  // 📍 NUOVI CAMPI PER LA MAPPA INTERATTIVA (DRAG & DROP)
  positionX Float @default(0.0)
  positionY Float @default(0.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
  
}

// --- 3. MENU E PRODOTTI (Cosa si vende) ---

model Category {
  id       String @id @default(uuid())
  name     String // Es: "Pizze", "Bibite"
  
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  products Product[]
}

model Product {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  isAvailable Boolean @default(true)
  imageUrl    String?

  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  orderItems  OrderItem[]
}

// --- 4. PRENOTAZIONI (Il futuro) ---

model Booking {
  id            String   @id @default(uuid())
  dateTime      DateTime // Data e ora prenotazione
  guests        Int      @default(2)
  status        String   @default("CONFIRMED") // PENDING, CONFIRMED, CANCELLED

  // 🚨 NUOVI CAMPI AGGIUNTI: Per le prenotazioni telefoniche o guest senza account
  customerName  String?  // Nome di chi prenota
  customerEmail String?  // Email (opzionale)
  customerPhone String?  // Telefono (opzionale, ma utilissimo)

  userId        String?  // Chi ha prenotato (se è un utente registrato sull'app)
  user          User?    @relation(fields: [userId], references: [id])

  resourceId    String?  // Quale tavolo/ombrellone (può essere assegnato dopo)
  resource      Resource? @relation(fields: [resourceId], references: [id])

  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  customerId    String?   // Se è un cliente in rubrica
  customer      Customer? @relation(fields: [customerId], references: [id])
}
// --- 5. ORDINI E CONTI (Il presente) ---

enum OrderStatus {
  OPEN      // Stanno mangiando
  PAID      // Hanno pagato
  CANCELLED // Errore
}

model Order {
  id          String      @id @default(uuid())
  totalAmount Decimal     @default(0.00) @db.Decimal(10, 2)
  status      OrderStatus @default(OPEN)
  createdAt   DateTime    @default(now())
  closedAt    DateTime?
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  resourceId  String?  // Es: Tavolo 4
  resource    Resource? @relation(fields: [resourceId], references: [id])
  
  userId      String?  // Chi ha preso l'ordine
  user        User?    @relation(fields: [userId], references: [id])

  items       OrderItem[]

  customerId    String?   // Per legare lo scontrino al programma fedeltà!
  customer      Customer? @relation(fields: [customerId], references: [id])
}

model OrderItem {
  id        String  @id @default(uuid())
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2) // Salviamo il prezzo storico
  notes     String? // Es: "No cipolla"

  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])
}

// --- 6. DECORAZIONI DELLA MAPPA (Muri, Porte, Testi liberi) ---
model MapElement {
  id        String   @id @default(uuid())
  
  // Può essere "WALL" (muro), "DOOR" (porta) o "TEXT" (testo)
  type      String   
  
  // Se è un testo, salviamo cosa c'è scritto (es. "Bagni"). Per i muri sarà null.
  text      String?  
  
  // Coordinate e Dimensioni
  positionX Float
  positionY Float
  width     Float
  height    Float
  
  // Rotazione (in futuro per fare i muri in diagonale!)
  rotation  Float    @default(0.0)

  tenantId  String
  // Ricordati di aggiungere `mapElements MapElement[]` nel model Tenant!
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

// --- 7. GESTIONE DEL PERSONALE (HR) ---

// Definiamo gli stati possibili di un dipendente
enum EmployeeStatus {
  ACTIVE      // Lavora regolarmente
  ON_LEAVE    // È in ferie/malattia a lungo termine
  TERMINATED  // Licenziato o dimesso (non eliminiamo il record per mantenere lo storico dei costi!)
}

model Employee {
  id                  String    @id @default(uuid())
  
  // -- ANAGRAFICA BASE --
  firstName           String    // Nome
  lastName            String    // Cognome
  email               String?   // Email (Opzionale, magari il lavapiatti non la usa)
  phone               String?   // Telefono (Fondamentale per il tasto WhatsApp!)
  taxCode             String?   // Codice Fiscale
  jobRole             String    // Il ruolo nel locale (Es: "Capo Sala", "Pizzaiolo")

  // -- CONTRATTO E SCADENZE (Le cose che fanno prendere le multe se scordate) --
  hireDate            DateTime  @default(now()) // Data di assunzione
  contractEndDate     DateTime? // Se è a tempo determinato, mettiamo la scadenza qui
  haccpExpiry         DateTime? // Scadenza attestato HACCP
  medicalCheckExpiry  DateTime? // Scadenza visita medica del lavoro

  // -- COSTI E ORARI (Per calcolare quanto ci costa a fine mese) --
  hourlyWage          Decimal   @default(0.00) @db.Decimal(10, 2) // Quanto lo paghiamo all'ora netti/lordi
  weeklyContractHours Int       @default(40) // Quante ore DEVE fare a settimana da contratto

  // -- EMERGENZE E ACCESSO --
  emergencyContact    String?   // Es: "Moglie - 3331234567"
  pinCode             String?   // Un PIN di 4/5 cifre che userà per timbrare sul tablet
  notes               String?   // Note libere (Es: "Allergico alle noci", "Disponibile solo sera")

  // -- SALDI FERIE E PERMESSI --
  // Usiamo Float così possiamo segnare anche mezza giornata (0.5)
  vacationDaysTotal   Float     @default(0) // Quanti giorni di ferie ha accumulato
  sickDaysTotal       Float     @default(0) // Giorni di malattia presi nell'anno

  // -- STATO ATTUALE --
  status              EmployeeStatus @default(ACTIVE)

  // -- RELAZIONI (I collegamenti con il resto dell'app) --
  
  // 1. A quale locale appartiene?
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id])

  // 2. Collegamento con l'App: Se il dipendente si scarica Juicy sul suo telefono 
  // per vedere i turni, lo leghiamo al suo account "User" (che ha ruolo STAFF).
  userId              String?   @unique // Unique perché un account User può essere un solo dipendente
  user                User?     @relation(fields: [userId], references: [id])

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  shifts        Shift[]
  leaves        LeaveRequest[]
  taskResults ChecklistTaskResult[]
}

// --- 8. GESTIONE TURNI E PIANIFICAZIONE ---

model Shift {
  id          String   @id @default(uuid())
  
  // Quando inizia e quando finisce il turno (Data + Ora)
  startTime   DateTime
  endTime     DateTime
  
  // Note specifiche per questo turno (es. "Oggi stai in cassa")
  notes       String?
  
  // RELAZIONI
  // 1. Il dipendente che deve lavorare
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // 2. Il locale
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Modello per Ferie e Permessi
model LeaveRequest {
  id          String   @id @default(uuid())
  type        String   // "VACATION" (Ferie), "SICK" (Malattia), "PERMIT" (Permesso)
  startDate   DateTime
  endDate     DateTime
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  createdAt   DateTime @default(now())
}

// --- 9. RUBRICA CLIENTI (CRM & FEDELTÀ) ---

model Customer {
  id          String    @id @default(uuid())
  firstName   String
  lastName    String?
  phone       String?   // Il nostro ponte d'oro per unire i dati
  email       String?
  notes       String?   // Es: "Allergico al glutine"

  // 💰 I CAMPI PER IL PROGRAMMA FEDELTÀ
  totalOrders Int       @default(0) // Quante volte è venuto a mangiare
  totalSpent  Decimal   @default(0.00) @db.Decimal(10, 2) // Quanti soldi ci ha lasciato

  // 🌉 IL PONTE: Se il cliente si scarica l'app Juicy
  userId      String?   @unique 
  user        User?     @relation(fields: [userId], references: [id])

  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  bookings    Booking[]
  orders      Order[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}





















// --- 10. CHECKLIST OPERATIVE E HACCP (Academy & Operations) ---

// Definiamo i tipi di risposta possibili per una domanda della checklist
enum TaskType {
  BOOLEAN // La classica spunta "Fatto / Non Fatto"
  NUMBER  // Inserimento di un numero (Fondamentale per le temperature HACCP)
  PHOTO   // Obbliga a scattare o caricare una foto (Es: "Foto del forno pulito")
  TEXT    // Testo libero (Es: "Segna qui se manca materiale")
}

// 1. IL MODELLO (Creato dal titolare una volta sola)
model ChecklistTemplate {
  id          String   @id @default(uuid())
  name        String   // Es: "Chiusura Cucina", "Controllo Bagni"
  description String?  // Istruzioni generali: "Da fare tutti i giorni alle 23:00"
  
  // Assegnazione: a chi è rivolta? (Es: "Cuoco", "Sala" - opzionale)
  targetRole  String?  

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  // 🔴 1. LE NUOVE REGOLE DI SCHEDULAZIONE 🔴
  // Array che contiene i giorni in cui il modello è attivo 
  // (es. ["MONDAY", "WEDNESDAY", "FRIDAY"])
  daysOfWeek  String[]
  
  // Array che contiene le fasce orarie in cui generare l'istanza 
  // (es. ["14:30", "23:45"]). Se un giorno ha 2 orari, il sistema ne genererà 2 al giorno!
  targetTimes String[]

  tasks       ChecklistTaskTemplate[] // Le domande dentro questo modello
  instances   ChecklistInstance[]     // Le copie giornaliere generate da questo modello

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 2. LE DOMANDE DEL MODELLO
model ChecklistTaskTemplate {
  id          String   @id @default(uuid())
  title       String   // Es: "Hai spento la friggitrice?", "Temperatura Frigo 1"
  type        TaskType @default(BOOLEAN) // Che tipo di risposta mi aspetto?
  isRequired  Boolean  @default(true)    // È obbligatoria per completare la checklist?
  order       Int      @default(0)       // L'ordine in cui mostrare le domande (1, 2, 3...)

  templateId  String
  template    ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  results     ChecklistTaskResult[] // I risultati reali inseriti dai camerieri
}

// 3. LA COPIA GIORNALIERA (Generata dal server ogni giorno per essere compilata)
model ChecklistInstance {
  id          String   @id @default(uuid())
  
  // Per la logica Lazy, la 'date' rappresenterà la "data logica" senza l'orario, 
  // ovvero il giorno esatto a cui si riferisce (es. 2026-07-24T00:00:00Z)
  date        DateTime 
  
  // 🔴 2. IL NUOVO CAMPO ORARIO 🔴
  // Questo campo ci dice per QUALE orario è stata generata questa copia specifica (es. "23:45")
  targetTime  String   

  status      String   @default("PENDING") // PENDING (In corso), COMPLETED (Finita)
  
  templateId  String
  template    ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  results     ChecklistTaskResult[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 🔴 3. IL VINCOLO SALVA-VITA (Indice Univoco Multiplo) 🔴
  // Questo è il vero trucco magico. Dicendo a PostgreSQL che la combinazione 
  // [template, giorno, orario] deve essere UNICA, rendiamo impossibile 
  // generare per errore la stessa checklist due volte, anche se 10 camerieri 
  // aprono l'app nello stesso esatto decimo di secondo!
  @@unique([templateId, date, targetTime])
}

// 4. LE RISPOSTE (L'azione reale del cameriere)
model ChecklistTaskResult {
  id              String   @id @default(uuid())
  
  // Salviamo la risposta come stringa per comodità, poi il frontend/backend la interpreterà
  // Se è BOOLEAN -> "true"
  // Se è NUMBER -> "4.5" (gradi)
  // Se è PHOTO -> "https://iltuosito.com/foto_forno.jpg"
  value           String?  
  
  // Se il cameriere ha un problema (es. "Finito il detersivo"), lo scrive qui
  notes           String?  
  
  // L'ora esatta spaccata al millisecondo in cui ha fatto "Tap"
  timestamp       DateTime @default(now())

  // Chi ha messo la spunta? (L'Accountability che vuole il titolare)
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])

  // A quale copia giornaliera appartiene?
  instanceId      String
  instance        ChecklistInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  // A quale domanda del modello sta rispondendo?
  taskTemplateId  String
  taskTemplate    ChecklistTaskTemplate @relation(fields: [taskTemplateId], references: [id], onDelete: Cascade)

  // MAGIC TRICK: Indice Univoco! 
  // Garantisce che in una specifica checklist giornaliera, una specifica domanda abbia UNA SOLA risposta.
  // Permette al database di fare l'UPSERT velocissimo senza doppioni!
  @@unique([instanceId, taskTemplateId])
}






// -------------------------------------------------------- MAGAZZINO --------------------------------------------------------










// --- 11. MAGAZZINO, FORNITORI E ORDINI (Inventory & Procurement) ---

// 1. IL FORNITORE (Supplier)
// Questa tabella salva l'anagrafica di chi ci vende la merce.
model Supplier {
  // L'identificativo unico del fornitore (generato in automatico)
  id        String   @id @default(uuid())
  
  // Il nome dell'azienda o della persona (es. "MARR", "Macelleria Rossi")
  name      String   
  
  // L'email del fornitore, utilissima per quando vorremo inviare il PDF dell'ordine in automatico
  email     String?  
  
  // Numero di telefono per contatti rapidi (opzionale)
  phone     String?  

  // Collegamento al Ristorante (Tenant): ogni ristorante ha i SUOI fornitori privati
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  // Relazione "Uno a Molti": Un fornitore ci porta TANTI prodotti diversi
  items     InventoryItem[] 
  
  // Relazione "Uno a Molti": A un fornitore possiamo fare TANTI ordini nel tempo
  orders    PurchaseOrder[] 
}

// 2. IL PRODOTTO / INGREDIENTE NEL MAGAZZINO (InventoryItem)
// Rappresenta l'oggetto fisico che sta in dispensa o in cella frigo.
model InventoryItem {
  id             String   @id @default(uuid())
  
  // Il nome del prodotto (es. "Farina 00", "Coca Cola in vetro")
  name           String   
  
  // Categoria merceologica utile per filtrare (es. "Secco", "Fresco", "Bevande")
  category       String   
  
  // Unità di misura con cui lo contiamo (es. "Kg", "Litri", "Pezzi", "Cartoni")
  unit           String   
  
  // QUANTITÀ ATTUALE: Quanti ne abbiamo fisicamente in casa in questo momento?
  // Usiamo Float (numeri con la virgola) perché potremmo avere "1.5 Kg" di carne
  currentStock   Float    
  
  // SOGLIA DI ALLARME: Se il currentStock scende sotto questo numero, 
  // il prodotto va in "Rosso" e il sistema ci suggerisce di ordinarlo!
  minimumStock   Float    
  
  // Quanto l'abbiamo pagato l'ultima volta? Utile per stimare il costo del prossimo ordine
  lastPrice      Float?   

  // A quale fornitore lo compriamo di solito? (È opzionale, magari lo compriamo un po' dove capita)
  supplierId     String?  
  supplier       Supplier? @relation(fields: [supplierId], references: [id])
  
  // Collegamento al Ristorante (Tenant)
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  
  // Relazione: Questo prodotto in quanti ordini è stato inserito storicamente?
  orderItems     PurchaseOrderItem[]
}

// 3. L'ORDINE INTERNO / LA LISTA DELLA SPESA (PurchaseOrder)
// Questo è il "carrello" che il titolare compone prima di generare il PDF per il fornitore.
model PurchaseOrder {
  id          String   @id @default(uuid())
  
  // Stato dell'ordine. Di default nasce come "DRAFT" (Bozza che stiamo scrivendo).
  // Poi diventerà "SENT" (Inviato al fornitore) e infine "DELIVERED" (Merce arrivata, aggiorna il magazzino!)
  status      String   @default("DRAFT") 
  
  // Data e ora in cui stiamo creando l'ordine
  orderDate   DateTime @default(now())
  
  // A quale fornitore stiamo facendo questo ordine? (Es. "Tutto questo va chiesto a MARR")
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  
  // Collegamento al Ristorante (Tenant)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  // La lista vera e propria delle cose che stiamo ordinando (Le "righe" dell'ordine)
  items       PurchaseOrderItem[]
}

// 4. LE VOCI DELL'ORDINE (PurchaseOrderItem)
// Rappresenta la singola riga della lista della spesa (es. "10 Kg di Farina a 1.20€ al kg")
model PurchaseOrderItem {
  id              String   @id @default(uuid())
  
  // Quanta quantità di questo prodotto stiamo chiedendo al fornitore in questo ordine?
  quantity        Float    
  
  // Il prezzo che ci aspettiamo di pagare (copiato dal 'lastPrice' del prodotto nel magazzino).
  // È utile per far vedere al titolare un "Totale stimato" prima di inviare l'ordine.
  expectedPrice   Float?   
  
  // A quale ordine (carrello) appartiene questa riga?
  // onDelete: Cascade significa che se cancello l'ordine, cancella in automatico anche le sue righe!
  orderId         String
  order           PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Che prodotto stiamo ordinando? (Collegamento all'anagrafica del magazzino)
  itemId          String
  item            InventoryItem @relation(fields: [itemId], references: [id])
}