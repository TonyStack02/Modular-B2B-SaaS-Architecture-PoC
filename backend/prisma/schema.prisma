// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- 1. UTENTI E RUOLI (Chi usa l'app) ---

enum UserRole {
  OWNER   // Proprietario del locale
  STAFF   // Cameriere, Bagnino, Barbiere
  CLIENT  // Cliente finale che ordina
}

model Tenant {
  id        String   @id @default(uuid())
  name      String   // Es: "Pizzeria Da Mario"
  type      String   @default("RESTAURANT") // RESTAURANT, BEACH, BARBER
  createdAt DateTime @default(now())

  // Relazioni
  users      User[]
  areas      Area[]
  resources    Resource[]
  categories Category[]
  products   Product[]
  orders     Order[]
  bookings   Booking[]
  mapElements MapElement[]
  employees   Employee[]
  shifts        Shift[]
  leaves        LeaveRequest[]  
  customers      Customer[]
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  password String
  name     String?
  role     UserRole @default(CLIENT)

  // Se è STAFF o OWNER, appartiene a un Tenant. Se è CLIENT, questo può essere null (o legato all'ultimo locale visitato)
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  employee    Employee? 
  customerProfile Customer? // Collegamento 1-a-1 con la rubrica del ristoratore

  bookings Booking[]
  orders   Order[]
}

// --- 2. RISORSE FISICHE (Dove ci si siede) ---

model Area {
  id       String @id @default(uuid())
  name     String // Es: "Sala Interna", "Dehor", "Fila 1"
  
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  resources Resource[]

  //Per disegnare il box dell'area sulla mappa
  positionX Float    @default(0.0)
  positionY Float    @default(0.0)
  width     Float    @default(400.0) 
  height    Float    @default(300.0)
}

model Resource {
  id        String  @id @default(uuid())
  name      String  // Es: "Tavolo 4", "Ombrellone 12"
  capacity  Int     @default(2)
  status    String  @default("FREE") // FREE, BUSY, RESERVED
  
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  areaId    String
  area      Area   @relation(fields: [areaId], references: [id])

  bookings  Booking[]
  orders    Order[]

  // 📍 NUOVI CAMPI PER LA MAPPA INTERATTIVA (DRAG & DROP)
  positionX Float @default(0.0)
  positionY Float @default(0.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
  
}

// --- 3. MENU E PRODOTTI (Cosa si vende) ---

model Category {
  id       String @id @default(uuid())
  name     String // Es: "Pizze", "Bibite"
  
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  products Product[]
}

model Product {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  isAvailable Boolean @default(true)
  imageUrl    String?

  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  orderItems  OrderItem[]
}

// --- 4. PRENOTAZIONI (Il futuro) ---

model Booking {
  id            String   @id @default(uuid())
  dateTime      DateTime // Data e ora prenotazione
  guests        Int      @default(2)
  status        String   @default("CONFIRMED") // PENDING, CONFIRMED, CANCELLED

  // 🚨 NUOVI CAMPI AGGIUNTI: Per le prenotazioni telefoniche o guest senza account
  customerName  String?  // Nome di chi prenota
  customerEmail String?  // Email (opzionale)
  customerPhone String?  // Telefono (opzionale, ma utilissimo)

  userId        String?  // Chi ha prenotato (se è un utente registrato sull'app)
  user          User?    @relation(fields: [userId], references: [id])

  resourceId    String?  // Quale tavolo/ombrellone (può essere assegnato dopo)
  resource      Resource? @relation(fields: [resourceId], references: [id])

  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  customerId    String?   // Se è un cliente in rubrica
  customer      Customer? @relation(fields: [customerId], references: [id])
}
// --- 5. ORDINI E CONTI (Il presente) ---

enum OrderStatus {
  OPEN      // Stanno mangiando
  PAID      // Hanno pagato
  CANCELLED // Errore
}

model Order {
  id          String      @id @default(uuid())
  totalAmount Decimal     @default(0.00) @db.Decimal(10, 2)
  status      OrderStatus @default(OPEN)
  createdAt   DateTime    @default(now())
  closedAt    DateTime?
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  resourceId  String?  // Es: Tavolo 4
  resource    Resource? @relation(fields: [resourceId], references: [id])
  
  userId      String?  // Chi ha preso l'ordine
  user        User?    @relation(fields: [userId], references: [id])

  items       OrderItem[]

  customerId    String?   // Per legare lo scontrino al programma fedeltà!
  customer      Customer? @relation(fields: [customerId], references: [id])
}

model OrderItem {
  id        String  @id @default(uuid())
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2) // Salviamo il prezzo storico
  notes     String? // Es: "No cipolla"

  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])
}

// --- 6. DECORAZIONI DELLA MAPPA (Muri, Porte, Testi liberi) ---
model MapElement {
  id        String   @id @default(uuid())
  
  // Può essere "WALL" (muro), "DOOR" (porta) o "TEXT" (testo)
  type      String   
  
  // Se è un testo, salviamo cosa c'è scritto (es. "Bagni"). Per i muri sarà null.
  text      String?  
  
  // Coordinate e Dimensioni
  positionX Float
  positionY Float
  width     Float
  height    Float
  
  // Rotazione (in futuro per fare i muri in diagonale!)
  rotation  Float    @default(0.0)

  tenantId  String
  // Ricordati di aggiungere `mapElements MapElement[]` nel model Tenant!
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

// --- 7. GESTIONE DEL PERSONALE (HR) ---

// Definiamo gli stati possibili di un dipendente
enum EmployeeStatus {
  ACTIVE      // Lavora regolarmente
  ON_LEAVE    // È in ferie/malattia a lungo termine
  TERMINATED  // Licenziato o dimesso (non eliminiamo il record per mantenere lo storico dei costi!)
}

model Employee {
  id                  String    @id @default(uuid())
  
  // -- ANAGRAFICA BASE --
  firstName           String    // Nome
  lastName            String    // Cognome
  email               String?   // Email (Opzionale, magari il lavapiatti non la usa)
  phone               String?   // Telefono (Fondamentale per il tasto WhatsApp!)
  taxCode             String?   // Codice Fiscale
  jobRole             String    // Il ruolo nel locale (Es: "Capo Sala", "Pizzaiolo")

  // -- CONTRATTO E SCADENZE (Le cose che fanno prendere le multe se scordate) --
  hireDate            DateTime  @default(now()) // Data di assunzione
  contractEndDate     DateTime? // Se è a tempo determinato, mettiamo la scadenza qui
  haccpExpiry         DateTime? // Scadenza attestato HACCP
  medicalCheckExpiry  DateTime? // Scadenza visita medica del lavoro

  // -- COSTI E ORARI (Per calcolare quanto ci costa a fine mese) --
  hourlyWage          Decimal   @default(0.00) @db.Decimal(10, 2) // Quanto lo paghiamo all'ora netti/lordi
  weeklyContractHours Int       @default(40) // Quante ore DEVE fare a settimana da contratto

  // -- EMERGENZE E ACCESSO --
  emergencyContact    String?   // Es: "Moglie - 3331234567"
  pinCode             String?   // Un PIN di 4/5 cifre che userà per timbrare sul tablet
  notes               String?   // Note libere (Es: "Allergico alle noci", "Disponibile solo sera")

  // -- SALDI FERIE E PERMESSI --
  // Usiamo Float così possiamo segnare anche mezza giornata (0.5)
  vacationDaysTotal   Float     @default(0) // Quanti giorni di ferie ha accumulato
  sickDaysTotal       Float     @default(0) // Giorni di malattia presi nell'anno

  // -- STATO ATTUALE --
  status              EmployeeStatus @default(ACTIVE)

  // -- RELAZIONI (I collegamenti con il resto dell'app) --
  
  // 1. A quale locale appartiene?
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id])

  // 2. Collegamento con l'App: Se il dipendente si scarica Juicy sul suo telefono 
  // per vedere i turni, lo leghiamo al suo account "User" (che ha ruolo STAFF).
  userId              String?   @unique // Unique perché un account User può essere un solo dipendente
  user                User?     @relation(fields: [userId], references: [id])

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  shifts        Shift[]
  leaves        LeaveRequest[]
}

// --- 8. GESTIONE TURNI E PIANIFICAZIONE ---

model Shift {
  id          String   @id @default(uuid())
  
  // Quando inizia e quando finisce il turno (Data + Ora)
  startTime   DateTime
  endTime     DateTime
  
  // Note specifiche per questo turno (es. "Oggi stai in cassa")
  notes       String?
  
  // RELAZIONI
  // 1. Il dipendente che deve lavorare
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // 2. Il locale
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Modello per Ferie e Permessi
model LeaveRequest {
  id          String   @id @default(uuid())
  type        String   // "VACATION" (Ferie), "SICK" (Malattia), "PERMIT" (Permesso)
  startDate   DateTime
  endDate     DateTime
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  createdAt   DateTime @default(now())
}

// --- 9. RUBRICA CLIENTI (CRM & FEDELTÀ) ---

model Customer {
  id          String    @id @default(uuid())
  firstName   String
  lastName    String?
  phone       String?   // Il nostro ponte d'oro per unire i dati
  email       String?
  notes       String?   // Es: "Allergico al glutine"

  // 💰 I CAMPI PER IL PROGRAMMA FEDELTÀ
  totalOrders Int       @default(0) // Quante volte è venuto a mangiare
  totalSpent  Decimal   @default(0.00) @db.Decimal(10, 2) // Quanti soldi ci ha lasciato

  // 🌉 IL PONTE: Se il cliente si scarica l'app Juicy
  userId      String?   @unique 
  user        User?     @relation(fields: [userId], references: [id])

  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  bookings    Booking[]
  orders      Order[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}